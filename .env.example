# Copy to .env.local for local overrides. Every variable is validated in src/config/env.ts.
# NEXT_PUBLIC_* values are built into the browser bundle: never put secrets in them.
# Local Supabase: `pnpm db:start && pnpm db:env` fills the Supabase keys, CRON_SECRET and VAPID keys for you.

# ── Public (built into the browser bundle) ───────────────────────────────────
# Production URL override (default: `url` in src/config/site.ts), e.g. https://care.jotno.workers.dev
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Web push public key (raw P-256, base64url)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# true while the site shows demo data (banner + noindex on demo vets)
NEXT_PUBLIC_DEMO=true
# true once a Google OAuth client is configured in Supabase Auth
NEXT_PUBLIC_GOOGLE_AUTH=false
# Demo site only: one-click owner/vet/admin sign-in buttons (needs NEXT_PUBLIC_DEMO=true). Never on the live site.
NEXT_PUBLIC_DEMO_LOGIN=false
# Local Google sign-in only (see [auth.external.google] in supabase/config.toml). Production: Supabase dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
NEXT_PUBLIC_SENTRY_DSN=

# Build mode override: static | server (default: `render` in src/config/site.ts; prefer `pnpm mode`)
RENDER_MODE=

# ── Server only ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_SERVICE_ROLE_KEY=
# manual (bKash/Nagad + trx id, cash on delivery; admin checks) | mock | sslcommerz
PAYMENT_PROVIDER=manual
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Bearer secret for /api/cron/* (GitHub Actions sends it)
CRON_SECRET=
# Web push private key (JWK "d", base64url)
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@jotnocare.com
# Cloudflare Realtime TURN key: relays calls that can't connect directly (mobile data).
# Dashboard → Realtime → TURN → create key. Empty: STUN only (some calls fail).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Or a TURN server with a fixed login (e.g. Metered Free 20 GB). Comma-separated turn:/turns: URLs.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Comma-separated emails that become admin on first sign-in
ADMIN_EMAILS=

# ── Deploy only (never needed by the app) ────────────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
