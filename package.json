{
  "name": "jotno",
  "version": "0.1.0",
  "private": true,
  "description": "Jotno: verified vets near you, pet Q&A and paid chat with a vet, in Bangla.",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/generate-assets.ts && next dev",
    "build": "node scripts/build.ts",
    "build:other": "node scripts/build-other.ts",
    "start": "node scripts/start.ts",
    "cf:build": "node scripts/generate-assets.ts && opennextjs-cloudflare build && node scripts/patch-open-next.ts",
    "cf:preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "pnpm cf:build && opennextjs-cloudflare deploy",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "mode": "node scripts/set-mode.ts",
    "locales": "node scripts/set-locales.ts",
    "freshness": "node scripts/freshness.ts",
    "auto-upgrade": "node scripts/auto-upgrade.ts",
    "setup-project": "node scripts/setup-project.ts",
    "github-setup": "node scripts/github-setup.ts",
    "prepare": "husky",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:generate": "drizzle-kit generate",
    "db:env": "node scripts/db-env.ts",
    "db:clear-demo": "node scripts/clear-demo.ts",
    "bvc:import": "node scripts/bvc-import.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@gsap/react": "2.1.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "gsap": "3.15.1",
    "lucide-react": "1.77.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "three": "0.187.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@napi-rs/canvas": "1.2.1",
    "@opennextjs/cloudflare": "1.20.18",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.1",
    "pdfjs-dist": "6.5.438",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "serve": "14.2.8",
    "shadcn": "4.23.0",
    "sharp": "0.35.5",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
